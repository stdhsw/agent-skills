{
  "editor.tokenColorCustomizations": {
    "[*Dark*]": {
      "textMateRules": [
        { "scope": "heading.1.markdown", "settings": { "foreground": "#F7768E", "fontStyle": "bold" } },
        { "scope": "heading.2.markdown", "settings": { "foreground": "#FF9E64", "fontStyle": "bold" } },
        { "scope": "heading.3.markdown", "settings": { "foreground": "#E0AF68", "fontStyle": "bold" } },
        { "scope": "heading.4.markdown", "settings": { "foreground": "#9ECE6A", "fontStyle": "bold" } },
        { "scope": "heading.5.markdown", "settings": { "foreground": "#7AA2F7", "fontStyle": "bold" } },
        { "scope": "heading.6.markdown", "settings": { "foreground": "#BB9AF7", "fontStyle": "bold" } },
        { "scope": "markup.bold.markdown", "settings": { "foreground": "#FF9E64", "fontStyle": "bold" } },
        { "scope": "markup.italic.markdown", "settings": { "foreground": "#BB9AF7", "fontStyle": "italic" } },
        { "scope": "markup.strikethrough.markdown", "settings": { "foreground": "#565F89", "fontStyle": "strikethrough" } },
        { "scope": "markup.inline.raw.string.markdown", "settings": { "foreground": "#73DACA" } },
        { "scope": "string.other.link.title.markdown", "settings": { "foreground": "#7AA2F7" } },
        { "scope": "markup.underline.link.markdown", "settings": { "foreground": "#565F89", "fontStyle": "underline" } },
        { "scope": "markup.quote.markdown", "settings": { "foreground": "#9AA5CE", "fontStyle": "italic" } },
        { "scope": "punctuation.definition.list.begin.markdown", "settings": { "foreground": "#7DCFFF", "fontStyle": "bold" } }
      ]
    },
    "[*Light*]": {
      "textMateRules": [
        { "scope": "heading.1.markdown", "settings": { "foreground": "#F52A65", "fontStyle": "bold" } },
        { "scope": "heading.2.markdown", "settings": { "foreground": "#B15C00", "fontStyle": "bold" } },
        { "scope": "heading.3.markdown", "settings": { "foreground": "#8C6C3E", "fontStyle": "bold" } },
        { "scope": "heading.4.markdown", "settings": { "foreground": "#587539", "fontStyle": "bold" } },
        { "scope": "heading.5.markdown", "settings": { "foreground": "#2E7DE9", "fontStyle": "bold" } },
        { "scope": "heading.6.markdown", "settings": { "foreground": "#9854F1", "fontStyle": "bold" } },
        { "scope": "markup.bold.markdown", "settings": { "foreground": "#B15C00", "fontStyle": "bold" } },
        { "scope": "markup.italic.markdown", "settings": { "foreground": "#9854F1", "fontStyle": "italic" } },
        { "scope": "markup.strikethrough.markdown", "settings": { "foreground": "#848CB5", "fontStyle": "strikethrough" } },
        { "scope": "markup.inline.raw.string.markdown", "settings": { "foreground": "#118C74" } },
        { "scope": "string.other.link.title.markdown", "settings": { "foreground": "#2E7DE9" } },
        { "scope": "markup.underline.link.markdown", "settings": { "foreground": "#848CB5", "fontStyle": "underline" } },
        { "scope": "markup.quote.markdown", "settings": { "foreground": "#6172B0", "fontStyle": "italic" } },
        { "scope": "punctuation.definition.list.begin.markdown", "settings": { "foreground": "#007197", "fontStyle": "bold" } }
      ]
    }
  },
  "markdown.styles": [".vscode/markdown-preview.css"],
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "files.trimTrailingWhitespace": false
  }
}
